// Shared build settings for every configuration (Dev and Prod).
// Target-specific settings live in the project file.

// Secrets: the token defaults to empty and is overridden by the optional,
// gitignored Secrets.xcconfig. A clean checkout builds without it.
TMDB_ACCESS_TOKEN =
#include? "Secrets.xcconfig"

SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TVOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
XROS_DEPLOYMENT_TARGET = 2.0

SDKROOT = iphoneos
CODE_SIGN_STYLE = Automatic
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
DEAD_CODE_STRIPPING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// A newer compiler on a reviewer's machine may add warnings; never fail on them.
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO

// Embedded frameworks are already signed; stripping on copy only produces warnings.
COPY_PHASE_STRIP = NO
